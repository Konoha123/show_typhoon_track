# Import Linter 分层契约：cli/api → service → core（AGENTS.md §5/§6）
[importlinter]
root_packages =
    typhoon_track

[importlinter:contract:layers]
name = 分层契约 cli/api → service → core（禁止反向依赖）
type = layers
layers =
    typhoon_track.cli
    typhoon_track.api
    typhoon_track.service
    typhoon_track.core
